{
  "name": "saanjh-premium-web-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-decoders.mjs",
    "build": "astro build",
    "build:harness": "node scripts/copy-decoders.mjs && HARNESS=1 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\" \"tests/**/*.astro\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,astro}\" \"tests/**/*.astro\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "lhci": "pnpm build && lhci autorun",
    "optimize:3d": "node scripts/optimize-3d.mjs",
    "intake:inventory": "node scripts/intake-inventory.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm lhci"
  },
  "dependencies": {
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "sharp": "0.35.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.12.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite-plugin-glsl": "1.6.1"
  }
}
