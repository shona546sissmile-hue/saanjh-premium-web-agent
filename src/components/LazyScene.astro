---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Name passed to registerScene(). */
  scene: string;
  /** Static fallback shown until the scene is ready, and whenever 3D is unavailable. */
  fallback: ImageMetadata;
  /** Describes the fallback image and, by extension, the scene. */
  alt: string;
  /** Use 'eager' only for a scene above the fold (it is then the LCP image). */
  loading?: 'lazy' | 'eager';
  /** How far ahead of the viewport to start loading the scene. */
  rootMargin?: string;
  sizes?: string;
  class?: string;
}

const {
  scene,
  fallback,
  alt,
  loading = 'lazy',
  rootMargin = '50% 0px',
  sizes = '100vw',
  class: className,
} = Astro.props;
---

<div class:list={['lazy-scene', className]} data-lazy-scene={scene} data-root-margin={rootMargin}>
  <Image
    class="lazy-scene__fallback"
    src={fallback}
    alt={alt}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    sizes={sizes}
    layout="full-width"
  />
  <canvas class="lazy-scene__canvas" aria-hidden="true"></canvas>
</div>

<style>
  .lazy-scene {
    position: relative;
    overflow: hidden;
    contain: layout paint;
  }

  .lazy-scene__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-slow) var(--ease-out-expo);
  }

  .lazy-scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out-expo);
  }

  .lazy-scene[data-scene-state='ready'] .lazy-scene__canvas {
    opacity: 1;
  }

  .lazy-scene[data-scene-state='ready'] .lazy-scene__fallback {
    opacity: 0;
  }
</style>

<script>
  import { mountLazyScenes } from '@/lib/three/lazy-scene';

  mountLazyScenes();
</script>
